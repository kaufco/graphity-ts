{
  // The examples are compiled and tested, never built or published. The packages resolve to their
  // sources, as in vitest.config.ts.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@kobayami/graphity": ["../graphity/src/index.ts"],
      "@kobayami/graphity-core": ["../core/src/index.ts"],
      "@kobayami/graphity-controlflow": ["../controlflow/src/index.ts"],
      "@kobayami/graphity-dot": ["../dot/src/index.ts"],
      "@kobayami/graphity-mermaid": ["../mermaid/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
